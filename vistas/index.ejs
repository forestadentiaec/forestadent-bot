<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forestadent Ecuador | Precisión Alemana en Ortodoncia B2B</title>
    <meta name="description" content="Representación oficial de Forestadent en Ecuador con 11 años de trayectoria. Brackets, autoligado, anclaje esquelético OrthoEasy, expansión Hyrax y ortodoncia digital Made in Black Forest.">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Montserrat', sans-serif; scroll-behavior: smooth; }
        .bg-forestadent { background-color: #0b1f38; }
        .bg-forestadent-dark { background-color: #071426; }
        .text-forestadent { color: #0b1f38; }
        .text-gold { color: #cda434; }
        .bg-gold { background-color: #cda434; }
        .border-gold { border-color: #cda434; }
        .hero-pattern {
            background-image: linear-gradient(120deg, rgba(7, 20, 38, 0.94), rgba(11, 31, 56, 0.86)),
                              url('https://images.unsplash.com/photo-1606811841689-23dfddce3e95?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80');
            background-size: cover;
            background-position: center;
        }
        .chat-scroll::-webkit-scrollbar { width: 6px; }
        .chat-scroll::-webkit-scrollbar-thumb { background-color: rgba(11, 31, 56, 0.25); border-radius: 9999px; }
        @keyframes pulse-ring {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(205, 164, 52, 0.65); }
            70% { transform: scale(1); box-shadow: 0 0 0 14px rgba(205, 164, 52, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(205, 164, 52, 0); }
        }
        .pulse-gold { animation: pulse-ring 2.6s infinite; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 antialiased">

    <!-- ========================================== -->
    <!-- BARRA DE NAVEGACIÓN CORPORATIVA            -->
    <!-- ========================================== -->
    <nav class="bg-forestadent/95 backdrop-blur-md text-white shadow-xl fixed w-full z-40 border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <!-- Logo Oficial Forestadent -->
                <div class="flex items-center space-x-3">
                    <a href="#inicio" class="flex items-center">
                        <img src="/logo-vector-forestadent.webp" alt="Forestadent Ecuador" class="h-10 sm:h-11 w-auto object-contain">
                    </a>
                    <span class="hidden sm:inline-block text-[11px] font-semibold text-gray-300 border-l border-gray-600 pl-3 uppercase tracking-widest">
                        Ecuador · Oficial B2B
                    </span>
                </div>

                <!-- Menú Escritorio -->
                <div class="hidden lg:flex items-center space-x-7 text-sm font-medium">
                    <a href="#especialidades" class="hover:text-gold transition">Especialidades</a>
                    <a href="#catalogo" class="hover:text-gold transition">Catálogo</a>
                    <a href="#posgrados" class="hover:text-gold transition">Posgrados</a>
                    <a href="#ecosistema-ia" class="hover:text-gold transition">Ecosistema IA</a>
                    <a href="#tradicion" class="hover:text-gold transition">Black Forest</a>
                    <button type="button" id="btnAbrirChatNav" class="bg-gold text-forestadent px-5 py-2.5 rounded-lg font-bold hover:bg-yellow-500 transition shadow-md flex items-center space-x-2">
                        <i class="fas fa-sparkles"></i>
                        <span>Asistente IA</span>
                    </button>
                </div>

                <!-- Botón Menú Móvil -->
                <div class="lg:hidden flex items-center space-x-3">
                    <button type="button" id="btnAbrirChatMovilTop" class="bg-gold text-forestadent px-3 py-2 rounded-lg text-xs font-bold">
                        <i class="fas fa-robot mr-1"></i> IA
                    </button>
                    <button type="button" id="btnMenuMovil" class="text-gray-200 hover:text-gold p-2" aria-label="Abrir menú">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Menú Desplegable Móvil -->
        <div id="menuMovil" class="hidden lg:hidden bg-forestadent-dark border-t border-white/10 px-4 pt-3 pb-5 space-y-2 text-sm">
            <a href="#especialidades" class="block py-2 text-gray-200 hover:text-gold">Especialidades Clínicas</a>
            <a href="#catalogo" class="block py-2 text-gray-200 hover:text-gold">Catálogo en Vivo</a>
            <a href="#posgrados" class="block py-2 text-gray-200 hover:text-gold">Posgrados y Universidades</a>
            <a href="#ecosistema-ia" class="block py-2 text-gray-200 hover:text-gold">Ecosistema IA para Clínicas</a>
            <a href="#tradicion" class="block py-2 text-gray-200 hover:text-gold">Made in Black Forest</a>
        </div>
    </nav>

    <!-- ========================================== -->
    <!-- HERO SECTION                               -->
    <!-- ========================================== -->
    <section id="inicio" class="hero-pattern text-white pt-32 pb-20 lg:pt-44 lg:pb-28 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="max-w-4xl mx-auto text-center">
                <span class="inline-flex items-center space-x-2 bg-gold/15 text-gold border border-gold/40 text-xs font-semibold px-4 py-1.5 rounded-full uppercase tracking-widest mb-6">
                    <i class="fas fa-award"></i>
                    <span>11 Años de Representación Oficial en Ecuador</span>
                </span>
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight leading-tight">
                    Precisión Alemana en Ortodoncia<br>
                    <span class="text-gold">Made in Black Forest</span>
                </h1>
                <p class="text-base sm:text-lg lg:text-xl text-gray-300 mb-10 max-w-3xl mx-auto leading-relaxed">
                    Nacidos en la tradición joyera y relojera de Pforzheim, Alemania. Suministramos a ortodoncistas, clínicas y posgrados universitarios en Ecuador con stock local de alta rotación y asesoría clínica asistida por Inteligencia Artificial.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <button type="button" id="btnAbrirChatHero" class="bg-gold text-forestadent font-bold px-8 py-4 rounded-xl shadow-xl hover:bg-yellow-500 transition flex items-center justify-center space-x-2">
                        <i class="fas fa-comments"></i>
                        <span>Cotizar o Consultar con Asistente IA</span>
                    </button>
                    <a href="#catalogo" class="border border-white/40 text-white font-semibold px-8 py-4 rounded-xl hover:bg-white hover:text-forestadent transition flex items-center justify-center space-x-2">
                        <span>Explorar Catálogo</span>
                        <i class="fas fa-arrow-down text-xs"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- BARRA DE INDICADORES DE CONFIANZA          -->
    <!-- ========================================== -->
    <section class="bg-forestadent-dark text-white border-y border-white/10 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
            <div class="p-2">
                <p class="text-3xl lg:text-4xl font-extrabold text-gold">11+ Años</p>
                <p class="text-xs text-gray-400 uppercase tracking-wider mt-1">Respaldo Oficial en Ecuador</p>
            </div>
            <div class="p-2">
                <p class="text-3xl lg:text-4xl font-extrabold text-white">+115 Años</p>
                <p class="text-xs text-gray-400 uppercase tracking-wider mt-1">Ingeniería en Pforzheim</p>
            </div>
            <div class="p-2">
                <p class="text-3xl lg:text-4xl font-extrabold text-gold">100%</p>
                <p class="text-xs text-gray-400 uppercase tracking-wider mt-1">Calidad Alemana Certificada</p>
            </div>
            <div class="p-2">
                <p class="text-3xl lg:text-4xl font-extrabold text-white">24/7</p>
                <p class="text-xs text-gray-400 uppercase tracking-wider mt-1">Atención y Cotización con IA</p>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- MUNDOS DE PRODUCTO / ESPECIALIDADES        -->
    <!-- ========================================== -->
    <section id="especialidades" class="py-20 lg:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-xs font-bold text-gold uppercase tracking-widest bg-gold/10 px-3 py-1 rounded-full">Ortodoncia de la A a la Z</span>
                <h2 class="text-3xl lg:text-4xl font-bold text-forestadent mt-4">Nuestras Líneas de Tratamiento</h2>
                <p class="text-gray-500 mt-3 text-sm sm:text-base">
                    Desde sistemas convencionales y autoligado de precisión micrométrica hasta anclaje esquelético y soluciones para flujo digital.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Pilar 1 -->
                <div class="bg-gray-50 rounded-2xl p-7 border border-gray-200 hover:border-gold hover:shadow-lg transition group">
                    <div class="w-12 h-12 rounded-xl bg-forestadent text-gold flex items-center justify-center text-xl mb-5 group-hover:scale-105 transition">
                        <i class="fas fa-tooth"></i>
                    </div>
                    <h3 class="text-lg font-bold text-forestadent mb-2">Ortodoncia Clásica</h3>
                    <p class="text-sm text-gray-600 leading-relaxed mb-4">
                        Brackets metálicos de perfil bajo (Mini Sprint, Easy Eco) y soluciones estéticas con superficies micropulidas y bases de alta retención.
                    </p>
                    <button type="button" class="btn-consultar-linea text-xs font-bold text-forestadent hover:text-gold uppercase tracking-wider inline-flex items-center" data-tema="Ortodoncia Clásica y Brackets Metálicos">
                        Consultar línea <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>

                <!-- Pilar 2 -->
                <div class="bg-gray-50 rounded-2xl p-7 border border-gray-200 hover:border-gold hover:shadow-lg transition group">
                    <div class="w-12 h-12 rounded-xl bg-forestadent text-gold flex items-center justify-center text-xl mb-5 group-hover:scale-105 transition">
                        <i class="fas fa-gem"></i>
                    </div>
                    <h3 class="text-lg font-bold text-forestadent mb-2">Autoligado Avanzado</h3>
                    <p class="text-sm text-gray-600 leading-relaxed mb-4">
                        Sistemas BioQuick® de 5ta generación y Quicklear® cerámicos. Control tridimensional, baja fricción y máxima comodidad clínica.
                    </p>
                    <button type="button" class="btn-consultar-linea text-xs font-bold text-forestadent hover:text-gold uppercase tracking-wider inline-flex items-center" data-tema="Brackets de Autoligado BioQuick y Quicklear">
                        Consultar línea <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>

                <!-- Pilar 3 -->
                <div class="bg-gray-50 rounded-2xl p-7 border border-gray-200 hover:border-gold hover:shadow-lg transition group">
                    <div class="w-12 h-12 rounded-xl bg-forestadent text-gold flex items-center justify-center text-xl mb-5 group-hover:scale-105 transition">
                        <i class="fas fa-crosshairs"></i>
                    </div>
                    <h3 class="text-lg font-bold text-forestadent mb-2">Anclaje & Expansión</h3>
                    <p class="text-sm text-gray-600 leading-relaxed mb-4">
                        Mini implantes OrthoEasy® codificados por color para seguridad clínica y tornillos de disyunción Hyrax de máxima estabilidad.
                    </p>
                    <button type="button" class="btn-consultar-linea text-xs font-bold text-forestadent hover:text-gold uppercase tracking-wider inline-flex items-center" data-tema="Mini Implantes OrthoEasy y Tornillos Hyrax">
                        Consultar línea <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>

                <!-- Pilar 4 -->
                <div class="bg-gray-50 rounded-2xl p-7 border border-gray-200 hover:border-gold hover:shadow-lg transition group">
                    <div class="w-12 h-12 rounded-xl bg-forestadent text-gold flex items-center justify-center text-xl mb-5 group-hover:scale-105 transition">
                        <i class="fas fa-cubes"></i>
                    </div>
                    <h3 class="text-lg font-bold text-forestadent mb-2">Ortodoncia Digital & 3D</h3>
                    <p class="text-sm text-gray-600 leading-relaxed mb-4">
                        Láminas de termoformado Track, alineadores FAS® y ecosistema de impresión 3D para clínicas que evolucionan hacia el flujo digital.
                    </p>
                    <button type="button" class="btn-consultar-linea text-xs font-bold text-forestadent hover:text-gold uppercase tracking-wider inline-flex items-center" data-tema="Ortodoncia Digital, Láminas Track y Flujo 3D">
                        Consultar línea <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- CATÁLOGO EN VIVO CON BUSCADOR Y FILTROS    -->
    <!-- ========================================== -->
    <section id="catalogo" class="py-20 lg:py-24 bg-gray-50 border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="text-xs font-bold text-gold uppercase tracking-widest bg-gold/10 px-3 py-1 rounded-full">Inventario Conectado en Tiempo Real</span>
                <h2 class="text-3xl lg:text-4xl font-bold text-forestadent mt-4">Catálogo Estratégico de Alta Rotación</h2>
                <p class="text-gray-500 mt-3 text-sm sm:text-base">
                    Busca por nombre o código y solicita tu cotización al instante con nuestro Asistente IA.
                </p>
            </div>

            <!-- Barra de Búsqueda y Filtros -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-gray-200 mb-10">
                <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
                    <div class="relative w-full md:w-96">
                        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input
                            type="text"
                            id="buscadorCatalogo"
                            placeholder="Buscar bracket, implante, tornillo o código..."
                            class="w-full pl-11 pr-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none focus:border-forestadent focus:ring-2 focus:ring-forestadent/10"
                        >
                    </div>
                    <div class="flex flex-wrap gap-2 justify-center md:justify-end" id="contenedorFiltros">
                        <button type="button" class="filtro-cat px-4 py-2 rounded-lg text-xs font-bold bg-forestadent text-white transition" data-categoria="TODAS">
                            Todos
                        </button>
                        <% categorias.forEach(function(cat) { %>
                            <button type="button" class="filtro-cat px-4 py-2 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700 hover:bg-gray-200 transition" data-categoria="<%= cat.toLowerCase() %>">
                                <%= cat %>
                            </button>
                        <% }); %>
                    </div>
                </div>
            </div>

            <!-- Grid Dinámico de Productos desde MongoDB -->
            <div id="gridProductos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
                <% if (productos && productos.length > 0) { %>
                    <% productos.forEach(function(p) { %>
                        <div
                            class="tarjeta-producto bg-white rounded-2xl shadow-sm overflow-hidden border border-gray-200 hover:shadow-xl hover:border-gold/60 transition flex flex-col justify-between"
                            data-nombre="<%= (p.nombre || '').toLowerCase() %>"
                            data-codigo="<%= (p.codigo || '').toLowerCase() %>"
                            data-categoria="<%= (p.categoria || '').toLowerCase() %>"
                        >
                            <div class="p-6">
                                <div class="flex items-center justify-between gap-2 mb-3">
                                    <span class="text-[11px] font-bold uppercase tracking-wider text-forestadent bg-blue-50 border border-blue-100 px-2.5 py-1 rounded-md">
                                        <%= p.categoria || 'Ortodoncia' %>
                                    </span>
                                    <% if (p.codigo) { %>
                                        <span class="text-[11px] font-mono text-gray-400">REF: <%= p.codigo %></span>
                                    <% } %>
                                </div>

                                <h3 class="font-bold text-lg text-forestadent mb-2 leading-snug"><%= p.nombre %></h3>
                                <p class="text-xs text-gray-500 mb-5">
                                    Presentación: <span class="font-semibold text-gray-700"><%= p.empaque || 'Unidad / Caso' %></span>
                                </p>

                                <div class="flex items-baseline justify-between border-t border-gray-100 pt-4">
                                    <div>
                                        <% if (typeof p.precio === 'number' && p.precio > 0) { %>
                                            <span class="text-2xl font-extrabold text-forestadent">$<%= p.precio.toFixed(2) %></span>
                                            <span class="text-xs text-gray-400 ml-1">ref.</span>
                                        <% } else { %>
                                            <span class="text-lg font-bold text-forestadent">Precio bajo cotización</span>
                                        <% } %>
                                    </div>
                                    <% if (typeof p.stock_actual === 'number' && p.stock_actual > 0) { %>
                                        <span class="inline-flex items-center text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">
                                            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-1.5"></span> En Stock
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center text-xs font-semibold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-full">
                                            Bajo pedido
                                        </span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
                                <button
                                    type="button"
                                    class="btn-cotizar-producto w-full text-sm font-bold text-forestadent hover:text-gold flex items-center justify-between transition"
                                    data-producto-nombre="<%= p.nombre %>"
                                    data-producto-codigo="<%= p.codigo || '' %>"
                                >
                                    <span>Cotizar con Asistente IA</span>
                                    <i class="fas fa-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-span-full bg-white rounded-2xl p-10 text-center border border-gray-200">
                        <i class="fas fa-box-open text-4xl text-gold mb-3"></i>
                        <h3 class="text-lg font-bold text-forestadent">Catálogo completo disponible bajo consulta</h3>
                        <p class="text-sm text-gray-500 mt-1 mb-5">Consulta precios, promociones y stock inmediato directamente en nuestro chat inteligente.</p>
                        <button type="button" class="btn-consultar-linea bg-forestadent text-white px-6 py-3 rounded-xl text-sm font-bold hover:bg-slate-800 transition" data-tema="Lista completa de precios y disponibilidad">
                            Solicitar catálogo ahora
                        </button>
                    </div>
                <% } %>
            </div>

            <!-- Mensaje sin resultados en búsqueda -->
            <div id="sinResultados" class="hidden bg-white rounded-2xl p-10 text-center border border-gray-200 mt-6">
                <p class="text-forestadent font-bold mb-1">No encontramos ese código o referencia en la vista rápida.</p>
                <p class="text-sm text-gray-500 mb-4">Manejamos todo el portafolio alemán de Forestadent bajo pedido directo.</p>
                <button type="button" id="btnConsultarNoEncontrado" class="bg-gold text-forestadent font-bold px-6 py-2.5 rounded-lg text-sm hover:bg-yellow-500 transition">
                    Preguntar disponibilidad al Asistente IA
                </button>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- ZONA EXCLUSIVA POSGRADOS Y UNIVERSIDADES   -->
    <!-- ========================================== -->
    <section id="posgrados" class="py-20 bg-white border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-gradient-to-br from-[#0b1f38] to-[#132f54] rounded-3xl p-8 sm:p-12 lg:p-14 text-white shadow-2xl grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                <div class="lg:col-span-7">
                    <span class="inline-block text-xs font-bold uppercase tracking-widest bg-gold/20 text-gold border border-gold/40 px-3 py-1 rounded-full mb-4">
                        Convenios Académicos Ecuador
                    </span>
                    <h2 class="text-2xl sm:text-4xl font-extrabold mb-4 leading-tight">
                        Tarifas Especiales para Posgrados y Clínicas Universitarias
                    </h2>
                    <p class="text-gray-300 text-sm sm:text-base leading-relaxed mb-6">
                        Acompañamos la formación de los futuros especialistas en ortodoncia del Ecuador con kits preferenciales por volumen, disponibilidad programada para inicios de semestre y soporte técnico directo.
                    </p>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-gray-200 mb-8">
                        <li class="flex items-center space-x-2"><i class="fas fa-check-circle text-gold"></i><span>Paquetes Mini Sprint Face por volumen</span></li>
                        <li class="flex items-center space-x-2"><i class="fas fa-check-circle text-gold"></i><span>Precios posgrado en BioQuick 5ta Gen</span></li>
                        <li class="flex items-center space-x-2"><i class="fas fa-check-circle text-gold"></i><span>Kits clínicos de Mini Implantes OrthoEasy</span></li>
                        <li class="flex items-center space-x-2"><i class="fas fa-check-circle text-gold"></i><span>Despachos coordinados a nivel nacional</span></li>
                    </ul>
                    <button type="button" class="btn-consultar-linea bg-gold text-forestadent font-bold px-7 py-3.5 rounded-xl hover:bg-yellow-500 transition shadow-lg" data-tema="Promociones y tarifas para Posgrado / Universidad">
                        Solicitar Tarifa de Posgrado
                    </button>
                </div>

                <div class="lg:col-span-5">
                    <div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-2xl p-6 sm:p-8 space-y-5">
                        <div class="flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-xl bg-gold text-forestadent flex items-center justify-center text-xl flex-shrink-0">
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-lg">Programa Académico</h3>
                                <p class="text-xs text-gray-300">Respaldo continuo durante toda tu especialidad.</p>
                            </div>
                        </div>
                        <div class="border-t border-white/15 pt-4 text-sm text-gray-200 space-y-2">
                            <p><strong class="text-gold">1.</strong> Identifícate en el Asistente IA indicando tu universidad o programa de posgrado.</p>
                            <p><strong class="text-gold">2.</strong> Recibe cotización inmediata con precios académicos preferenciales.</p>
                            <p><strong class="text-gold">3.</strong> Coordina entrega rápida en Quito o envío asegurado a cualquier ciudad del país.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- ECOSISTEMA IA PARA CLÍNICAS ALIADAS        -->
    <!-- ========================================== -->
    <section id="ecosistema-ia" class="py-20 bg-gray-50 border-t border-gray-200">
