    <!-- ========================================== -->
    <!-- LÓGICA INTERACTIVA (FILTROS + CHAT IA)     -->
    <!-- ========================================== -->
    <script>
        (function () {
            const WHATSAPP_NUMERO = "<%= whatsappNumero %>";

            // --- MENÚ MÓVIL ---
            const btnMenuMovil = document.getElementById('btnMenuMovil');
            const menuMovil = document.getElementById('menuMovil');
            if (btnMenuMovil && menuMovil) {
                btnMenuMovil.addEventListener('click', () => {
                    menuMovil.classList.toggle('hidden');
                });
                menuMovil.querySelectorAll('a').forEach(a => {
                    a.addEventListener('click', () => menuMovil.classList.add('hidden'));
                });
            }

            // --- BUSCADOR Y FILTROS DEL CATÁLOGO ---
            const buscador = document.getElementById('buscadorCatalogo');
            const botonesFiltro = document.querySelectorAll('.filtro-cat');
            const tarjetas = document.querySelectorAll('.tarjeta-producto');
            const sinResultados = document.getElementById('sinResultados');
            let categoriaActiva = 'TODAS';

            function filtrarCatalogo() {
                const texto = (buscador ? buscador.value : '').trim().toLowerCase();
                let visibles = 0;

                tarjetas.forEach(card => {
                    const nombre = card.dataset.nombre || '';
                    const codigo = card.dataset.codigo || '';
                    const cat = card.dataset.categoria || '';

                    const coincideTexto = !texto || nombre.includes(texto) || codigo.includes(texto) || cat.includes(texto);
                    const coincideCat = categoriaActiva === 'TODAS' || cat === categoriaActiva;

                    if (coincideTexto && coincideCat) {
                        card.classList.remove('hidden');
                        visibles++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                if (sinResultados) {
                    if (tarjetas.length > 0 && visibles === 0) {
                        sinResultados.classList.remove('hidden');
                    } else {
                        sinResultados.classList.add('hidden');
                    }
                }
            }

            if (buscador) {
                buscador.addEventListener('input', filtrarCatalogo);
            }

            botonesFiltro.forEach(btn => {
                btn.addEventListener('click', () => {
                    categoriaActiva = btn.dataset.categoria;
                    botonesFiltro.forEach(b => {
                        b.classList.remove('bg-forestadent', 'text-white', 'font-bold');
                        b.classList.add('bg-gray-100', 'text-gray-700', 'font-semibold');
                    });
                    btn.classList.remove('bg-gray-100', 'text-gray-700', 'font-semibold');
                    btn.classList.add('bg-forestadent', 'text-white', 'font-bold');
                    filtrarCatalogo();
                });
            });

            // --- CHATBOT WEB CON IA Y CAPTURA A MONGODB ---
            const chatVentana = document.getElementById('chatVentana');
            const btnBurbuja = document.getElementById('btnBurbujaChat');
            const btnCerrar = document.getElementById('btnCerrarChat');
            const pasoRegistro = document.getElementById('chatPasoRegistro');
            const pasoConversacion = document.getElementById('chatPasoConversacion');
            const formRegistro = document.getElementById('formRegistroChat');
            const errorRegistro = document.getElementById('errorRegistroChat');
            const btnIniciarChat = document.getElementById('btnIniciarChat');
            const chatMensajes = document.getElementById('chatMensajes');
            const formMensaje = document.getElementById('formMensajeChat');
            const inputMensaje = document.getElementById('inputMensajeChat');
            const btnEnviar = document.getElementById('btnEnviarMensaje');
            const contenedorWa = document.getElementById('contenedorCierreWhatsapp');
            const enlaceWa = document.getElementById('enlaceCierreWhatsapp');

            let leadActual = null;
            let historialChat = [];
            let mensajePendiente = '';
            let enviando = false;

            // Recuperar lead de la sesión del navegador si ya se registró
            try {
                const guardado = sessionStorage.getItem('foresta_lead_web');
                if (guardado) {
                    leadActual = JSON.parse(guardado);
                    mostrarPantallaConversacion(false);
                }
            } catch (e) {}

            function abrirChat(mensajeSugerido) {
                chatVentana.classList.remove('hidden');
                if (mensajeSugerido) {
                    if (leadActual) {
                        enviarMensajeAlServidor(mensajeSugerido);
                    } else {
                        mensajePendiente = mensajeSugerido;
                    }
                }
            }

            function cerrarChat() {
                chatVentana.classList.add('hidden');
            }

            function escaparHtml(texto) {
                const div = document.createElement('div');
                div.textContent = texto;
                return div.innerHTML;
            }

            function formatearTextoIA(texto) {
                return escaparHtml(texto)
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\n/g, '<br>');
            }

            function agregarBurbuja(rol, texto) {
                const wrap = document.createElement('div');
                wrap.className = rol === 'usuario' ? 'flex justify-end' : 'flex justify-start';

                const burbuja = document.createElement('div');
                burbuja.className = rol === 'usuario'
                    ? 'bg-forestadent text-white px-4 py-2.5 rounded-2xl rounded-br-sm max-w-[85%] shadow-sm leading-relaxed'
                    : 'bg-white text-gray-800 border border-gray-200 px-4 py-2.5 rounded-2xl rounded-bl-sm max-w-[88%] shadow-sm leading-relaxed';

                burbuja.innerHTML = formatearTextoIA(texto);
                wrap.appendChild(burbuja);
                chatMensajes.appendChild(wrap);
                chatMensajes.scrollTop = chatMensajes.scrollHeight;
            }

            function actualizarBotonWhatsapp(ultimoTema) {
                if (!WHATSAPP_NUMERO || !leadActual) return;
                const resumen = `Hola Forestadent Ecuador, soy ${leadActual.nombre} (${leadActual.establecimiento || 'Especialista'}). Vengo del Asistente IA web y deseo continuar con: ${ultimoTema || 'mi cotización'}`;
                enlaceWa.href = `https://wa.me/${WHATSAPP_NUMERO}?text=${encodeURIComponent(resumen)}`;
                contenedorWa.classList.remove('hidden');
            }

            function mostrarPantallaConversacion(esNuevo) {
                pasoRegistro.classList.add('hidden');
                pasoConversacion.classList.remove('hidden');

                if (chatMensajes.children.length === 0) {
                    const saludo = `¡Hola, **${leadActual.nombre}**! Soy el Asistente IA de Forestadent Ecuador. Ya registré tus datos para darte atención personalizada. ¿En qué producto, cotización o duda clínica te puedo ayudar hoy?`;
                    agregarBurbuja('asistente', saludo);
                    historialChat.push({ rol: 'asistente', texto: saludo });
                }

                if (WHATSAPP_NUMERO) {
                    actualizarBotonWhatsapp('consulta desde portal web');
                }

                if (esNuevo && mensajePendiente) {
                    const temp = mensajePendiente;
                    mensajePendiente = '';
                    enviarMensajeAlServidor(temp);
                }
            }

            async function enviarMensajeAlServidor(texto) {
                if (!texto || enviando) return;
                enviando = true;
                btnEnviar.disabled = true;

                agregarBurbuja('usuario', texto);
                historialChat.push({ rol: 'usuario', texto });

                // Indicador de escritura
                const typingId = 'typing-' + Date.now();
                const typingWrap = document.createElement('div');
                typingWrap.id = typingId;
                typingWrap.className = 'flex justify-start';
                typingWrap.innerHTML = '<div class="bg-white border border-gray-200 px-4 py-2.5 rounded-2xl text-xs text-gray-400 italic">Consultando catálogo y especificaciones...</div>';
                chatMensajes.appendChild(typingWrap);
                chatMensajes.scrollTop = chatMensajes.scrollHeight;

                try {
                    const res = await fetch('/api/chat-web/mensaje', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            mensaje: texto,
                            historial: historialChat.slice(-8),
                            lead: leadActual
                        })
                    });
                    const data = await res.json();

                    const elTyping = document.getElementById(typingId);
                    if (elTyping) elTyping.remove();

                    if (data.ok && data.respuesta) {
                        agregarBurbuja('asistente', data.respuesta);
                        historialChat.push({ rol: 'asistente', texto: data.respuesta });
                        if (data.sugerirWhatsapp) {
                            actualizarBotonWhatsapp(texto);
                        }
                    } else {
                        agregarBurbuja('asistente', data.error || 'No pude procesar tu mensaje en este momento.');
                    }
                } catch (err) {
                    const elTyping = document.getElementById(typingId);
                    if (elTyping) elTyping.remove();
                    agregarBurbuja('asistente', 'Error de conexión con el servidor. Por favor intenta nuevamente.');
                } finally {
                    enviando = false;
                    btnEnviar.disabled = false;
                    inputMensaje.focus();
                }
            }

            // Registro inicial del Lead
            formRegistro.addEventListener('submit', async (e) => {
                e.preventDefault();
                errorRegistro.classList.add('hidden');

                const nombre = document.getElementById('inputLeadNombre').value.trim();
                const telefono = document.getElementById('inputLeadTelefono').value.trim();
                const establecimiento = document.getElementById('inputLeadEstablecimiento').value.trim();

                btnIniciarChat.disabled = true;
                btnIniciarChat.innerHTML = '<span>Registrando...</span>';

                try {
                    const res = await fetch('/api/chat-web/registro', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            nombre,
                            telefono,
                            establecimiento,
                            motivo: mensajePendiente
                        })
                    });
                    const data = await res.json();

                    if (!res.ok || !data.ok) {
                        errorRegistro.textContent = data.error || 'Verifica tus datos e intenta nuevamente.';
                        errorRegistro.classList.remove('hidden');
                        return;
                    }

                    leadActual = data.lead;
                    sessionStorage.setItem('foresta_lead_web', JSON.stringify(leadActual));
                    mostrarPantallaConversacion(true);
                } catch (err) {
                    errorRegistro.textContent = 'Error de conexión. Intenta nuevamente.';
                    errorRegistro.classList.remove('hidden');
                } finally {
                    btnIniciarChat.disabled = false;
                    btnIniciarChat.innerHTML = '<span>Iniciar Conversación con IA</span><i class="fas fa-arrow-right text-gold text-xs"></i>';
                }
            });

            // Envío de mensajes en chat activo
            formMensaje.addEventListener('submit', (e) => {
                e.preventDefault();
                const texto = inputMensaje.value.trim();
                if (!texto) return;
                inputMensaje.value = '';
                enviarMensajeAlServidor(texto);
            });

            // Botones de apertura del chat en toda la Landing
            btnBurbuja.addEventListener('click', () => {
                if (chatVentana.classList.contains('hidden')) abrirChat();
                else cerrarChat();
            });
            btnCerrar.addEventListener('click', cerrarChat);

            ['btnAbrirChatNav', 'btnAbrirChatMovilTop', 'btnAbrirChatHero'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.addEventListener('click', () => abrirChat());
            });

            // Botones de "Cotizar con Asistente IA" en cada tarjeta de producto
            document.querySelectorAll('.btn-cotizar-producto').forEach(btn => {
                btn.addEventListener('click', () => {
                    const nombreProd = btn.dataset.productoNombre || 'este producto';
                    const codigoProd = btn.dataset.productoCodigo ? ` (Ref: ${btn.dataset.productoCodigo})` : '';
                    abrirChat(`Hola, deseo cotizar y consultar disponibilidad de: ${nombreProd}${codigoProd}`);
                });
            });

            // Botones de líneas clínicas y posgrados
            document.querySelectorAll('.btn-consultar-linea').forEach(btn => {
                btn.addEventListener('click', () => {
                    const tema = btn.dataset.tema || 'catálogo Forestadent';
                    abrirChat(`Hola, necesito información y precios sobre: ${tema}`);
                });
            });

            // Botón de producto no encontrado en búsqueda
            const btnNoEncontrado = document.getElementById('btnConsultarNoEncontrado');
            if (btnNoEncontrado) {
                btnNoEncontrado.addEventListener('click', () => {
                    const q = (buscador ? buscador.value.trim() : '') || 'un producto específico';
                    abrirChat(`Hola, busqué "${q}" en el catálogo web y quisiera saber si lo tienen disponible o bajo pedido.`);
                });
            }

            // Botón Solicitar Panel IA para consultorio/clínica
            const btnPanelIA = document.getElementById('btnSolicitarPanelIA');
            if (btnPanelIA) {
                btnPanelIA.addEventListener('click', () => {
                    abrirChat('Hola, soy cliente/especialista interesado en solicitar mi propio Panel con Asistente IA para mi consultorio o clínica.');
                });
            }

            // Chips rápidos dentro del chat
            document.querySelectorAll('.chip-chat').forEach(chip => {
                chip.addEventListener('click', () => {
                    const msg = chip.dataset.msg;
                    if (msg) enviarMensajeAlServidor(msg);
                });
            });
        })();
    </script>
</body>
</html>